<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>FringeShiftKCM</class>
 <widget class="QWidget" name="FringeShiftKCM">
  <layout class="QVBoxLayout" name="rootLayout">
   <item>
    <!-- Text and message type are set in FringeShiftKCM.cpp, which decides
         between them by reading the current font settings. -->
    <widget class="KMessageWidget" name="subPixelNotice"/>
   </item>
   <item>
    <!-- Presets. These only write the widgets below; the commit is Apply's, like
         every other control on the page. Values and rationale live in
         presets.conf, and the table in FringeShiftKCM.cpp names the block each
         button reproduces. -->
    <layout class="QHBoxLayout" name="presetLayout">
     <property name="spacing">
      <number>6</number>
     </property>
     <item>
      <widget class="QLabel" name="presetLabel">
       <property name="text">
        <string>Preset:</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="presetMpeButton">
       <property name="text">
        <string>MPE</string>
       </property>
       <property name="toolTip">
        <string>Emitter lattice measured across ~60 cells of a macro photograph, so per-cell reading error averages out. Separations 0.437 px vertical, 0.449 px horizontal.</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="presetSpeButton">
       <property name="text">
        <string>SPE</string>
       </property>
       <property name="toolTip">
        <string>The same panel read from the scale drawing of one cell: 0.472 px vertical, 0.441 px horizontal. The only preset here that shifts green sideways.</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="presetOsorioButton">
       <property name="text">
        <string>Osorio</string>
       </property>
       <property name="toolTip">
        <string>Not a measurement of the panel but of a working correction: sample rectangles moved by hand on live hardware until the fringing went away. 0.450 px vertical, 0.475 px horizontal — and what this effect ships with.</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="presetTriadButton">
       <property name="text">
        <string>Triad</string>
       </property>
       <property name="toolTip">
        <string>Vertical only, and roughly a third of the measured geometry: the floor of the useful range. Visible on a fringe test pattern, near invisible in normal use.</string>
       </property>
      </widget>
     </item>
     <item>
      <spacer name="presetSpacer">
       <property name="orientation">
        <enum>Qt::Horizontal</enum>
       </property>
       <property name="sizeHint" stdset="0">
        <size>
         <width>0</width>
         <height>0</height>
        </size>
       </property>
      </spacer>
     </item>
    </layout>
   </item>
   <item>
    <widget class="Line" name="presetSeparator">
     <property name="orientation">
      <enum>Qt::Horizontal</enum>
     </property>
    </widget>
   </item>
   <item>
    <layout class="QGridLayout" name="gridLayout">
     <property name="horizontalSpacing">
      <number>8</number>
     </property>
     <!-- Column stretch is set in FringeShiftKCM.cpp: ki18n's uic wrapper puts
          every <string> property through tr2i18n(), which does not compile
          against setColumnStretch(int, int). -->

     <!-- Red -->
     <item row="0" column="0">
      <widget class="QLabel" name="redLabel">
       <property name="text">
        <string>Red:</string>
       </property>
       <property name="alignment">
        <set>Qt::AlignRight|Qt::AlignVCenter</set>
       </property>
      </widget>
     </item>
