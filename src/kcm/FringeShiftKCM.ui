     <!-- Toggles -->
     <item row="5" column="0" colspan="7">
      <layout class="QHBoxLayout" name="toggleLayout">
       <property name="spacing">
        <number>16</number>
       </property>
       <item>
        <widget class="QCheckBox" name="kcfg_Bicubic">
         <property name="text">
          <string>Bicubic</string>
         </property>
         <property name="toolTip">
          <string>Catmull-Rom resample. Unchecked falls back to bilinear: softer, but free of ringing.</string>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QCheckBox" name="kcfg_Adaptive">
         <property name="text">
          <string>Adaptive</string>
         </property>
         <property name="toolTip">
          <string>Restrict sharpening to text-like pixels. Never affects the channel shift itself.</string>
         </property>
        </widget>
       </item>
       <item>
        <spacer name="toggleSpacer">
         <property name="orientation">
          <enum>Qt::Horizontal</enum>
         </property>
         <property name="sizeHint" stdset="0">
          <size>
